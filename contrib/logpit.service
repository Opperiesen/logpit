[Unit]
Description=LogPit log aggregator
After=network.target

[Service]
ExecStart=/usr/local/bin/logpit --config /etc/logpit/logpit.toml
WorkingDirectory=/var/lib/logpit
StateDirectory=logpit
DynamicUser=yes
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Needed to bind syslog on port 514:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
