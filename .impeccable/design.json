  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default outlined control: ground fill, field-grey border, bold label; band-grey hover, no easing.",
      "html": "<button class=\"ds-btn\">Save view</button>",
      "css": ".ds-btn{height:32px;padding:0 12px;border:1px solid var(--field,#8a8a8a);border-radius:2px;background:var(--ground,#fff);color:var(--ink,#111);font:600 14px/1.45 \"Helvetica Neue\",Helvetica,Arial,system-ui,sans-serif;cursor:pointer}.ds-btn:hover{background:var(--band,#f2f2f2)}.ds-btn:focus-visible{outline:2px solid var(--focus,#2d327d);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single filled red action per screen (Search).",
      "html": "<button class=\"ds-btn-primary\">Search</button>",
      "css": ".ds-btn-primary{height:32px;padding:0 12px;border:1px solid var(--primary,#d30000);border-radius:2px;background:var(--primary,#d30000);color:#fff;font:600 14px/1.45 \"Helvetica Neue\",Helvetica,Arial,system-ui,sans-serif;cursor:pointer}.ds-btn-primary:hover{background:var(--primary-hover,#b00000)}.ds-btn-primary:focus-visible{outline:2px solid var(--focus,#2d327d);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "32px field with a field-grey border and 2px corners.",
      "html": "<input class=\"ds-input\" type=\"search\" placeholder=\"field:value\">",
      "css": ".ds-input{height:32px;padding:0 8px;border:1px solid var(--field,#8a8a8a);border-radius:2px;background:var(--ground,#fff);color:var(--ink,#111);font:14px/1.45 \"Helvetica Neue\",Helvetica,Arial,system-ui,sans-serif}.ds-input::placeholder{color:var(--muted,#5e5e5e);opacity:1}.ds-input:focus-visible{outline:2px solid var(--focus,#2d327d);outline-offset:2px}"
    },
    {
      "name": "Header Band",
      "kind": "nav",
      "refersTo": "header-band",
      "description": "Platform-navy control strip: wordmark, wide search, Live, the red Search button, status right.",
      "html": "<div class=\"ds-hdr\"><b class=\"ds-hdr-mark\">LogPit</b><input class=\"ds-hdr-q\" type=\"search\" placeholder=\"Search messages…\"><label class=\"ds-hdr-l\"><input type=\"checkbox\"> Live</label><button class=\"ds-hdr-go\">Search</button><span class=\"ds-hdr-st\">500 entries</span></div>",
      "css": ".ds-hdr{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:10px 16px;background:var(--shell,#2d327d);color:#fff;font:14px/1.45 \"Helvetica Neue\",Helvetica,Arial,system-ui,sans-serif}.ds-hdr-mark{margin-right:12px;font-size:20px;line-height:32px;letter-spacing:-.01em}.ds-hdr-q{flex:1 1 200px;height:32px;padding:0 8px;border:1px solid var(--shell-line,#8f94c8);border-radius:2px;background:var(--shell-field,#fff);color:var(--shell-field-ink,#111);font:inherit}.ds-hdr-q:focus-visible,.ds-hdr-go:focus-visible{outline:2px solid #fff;outline-offset:2px}.ds-hdr-l{display:flex;align-items:center;gap:6px;font-weight:600}.ds-hdr-l input{accent-color:#d30000}.ds-hdr-go{height:32px;padding:0 12px;border:1px solid #d30000;border-radius:2px;background:#d30000;color:#fff;font:inherit;font-weight:600;cursor:pointer}.ds-hdr-go:hover{background:#b00000}.ds-hdr-st{margin-left:auto;color:var(--shell-muted,#c3c6ea);font-size:13px}"
    },
    {
      "name": "Hour Band",
      "kind": "custom",
      "refersTo": "hour-band",
      "description": "Signature: the hour stated once on a sticky band; lines below lead with grey HH: and bold MM:SS, errors in red.",
      "html": "<table class=\"ds-tt\"><tr class=\"ds-band\"><th colspan=\"4\"><span class=\"ds-h\">14:00</span><span class=\"ds-d\">Sun, 4 Oct 2026</span><span class=\"ds-c\">32 entries · <span class=\"ds-e\">4 errors</span> · <span class=\"ds-w\">3 warnings</span></span></th></tr><tr><td class=\"ds-ts\"><span class=\"ds-hh\">14:</span>12:12</td><td class=\"ds-sev ds-s6\">info</td><td class=\"ds-host\">pve</td><td class=\"ds-msg\">GET /api/v1/items/9 HTTP/1.1 200 512</td></tr><tr class=\"ds-err\"><td class=\"ds-ts\"><span class=\"ds-hh\">14:</span>08:41</td><td class=\"ds-sev ds-s3\">err</td><td class=\"ds-host\">lxc-git</td><td class=\"ds-msg\">authentication failure; rhost=10.0.0.54</td></tr><tr><td class=\"ds-ts\"><span class=\"ds-hh\">14:</span>06:27</td><td class=\"ds-sev ds-s4\">warn</td><td class=\"ds-host\">nas</td><td class=\"ds-msg\">query: example69.lan A IN</td></tr></table>",
      "css": ".ds-tt{width:100%;border-collapse:collapse;font:14px/1.45 \"Helvetica Neue\",Helvetica,Arial,system-ui,sans-serif;font-variant-numeric:tabular-nums;color:var(--ink,#111);background:var(--ground,#fff)}.ds-band th{position:sticky;top:0;padding:8px 10px 6px 16px;background:var(--band,#f2f2f2);border-bottom:1px solid var(--ink,#111);text-align:left;font-weight:400}.ds-h{font-size:20px;font-weight:700;line-height:1;margin-right:10px;color:var(--band-hour,#111)}.ds-d{color:var(--muted,#5e5e5e)}.ds-c{float:right;font-size:12.5px;color:var(--muted,#5e5e5e)}.ds-e{color:var(--err,#d30000);font-weight:700}.ds-w{color:var(--warn,#9a5300);font-weight:700}.ds-tt td{padding:4px 10px;border-bottom:1px solid var(--rule,#d6d6d6);vertical-align:baseline}.ds-tt td:first-child{padding-left:16px}.ds-ts{width:1%;white-space:nowrap;font-weight:700}.ds-hh{color:var(--muted,#5e5e5e);font-weight:400}.ds-err .ds-ts,.ds-err .ds-hh{color:var(--err,#d30000)}.ds-sev{width:1%;font-size:12px;font-weight:700}.ds-s3{color:var(--err,#d30000)}.ds-s4{color:var(--warn,#9a5300)}.ds-s6{color:var(--muted,#5e5e5e)}.ds-host{width:1%;white-space:nowrap;font-weight:600}.ds-msg{font:12.5px/1.45 ui-monospace,\"SF Mono\",Menlo,Consolas,monospace;white-space:pre-wrap}"
    },
    {
      "name": "Silent Badge",
      "kind": "chip",
      "refersTo": "badge-silent",
      "description": "Red marker after a host that stopped sending logs.",
      "html": "<span class=\"ds-host-name\">udr7</span><span class=\"ds-badge\">silent</span>",
      "css": ".ds-host-name{font:600 12.5px/1.45 \"Helvetica Neue\",Helvetica,Arial,system-ui,sans-serif}.ds-badge{display:inline-block;margin-left:6px;padding:0 5px;border-radius:2px;background:var(--err,#d30000);color:var(--ground,#fff);font:700 11px/16px \"Helvetica Neue\",Helvetica,Arial,system-ui,sans-serif}"
    },
    {
      "name": "Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Outlined host tag, clickable to filter.",
      "html": "<span class=\"ds-tag\" tabindex=\"0\" role=\"button\">proxmox</span>",
      "css": ".ds-tag{display:inline-block;margin:2px 4px 0 0;padding:0 5px;border:1px solid var(--field,#8a8a8a);border-radius:2px;color:var(--muted,#5e5e5e);font:400 11px/16px \"Helvetica Neue\",Helvetica,Arial,system-ui,sans-serif;cursor:pointer}.ds-tag:hover{color:var(--accent,#2d327d)}.ds-tag:focus-visible{outline:2px solid var(--focus,#2d327d);outline-offset:2px}"
    },
    {
      "name": "Context Panel",
      "kind": "card",
      "refersTo": "context-panel",
      "description": "Tinted panel opened under a line, showing the surrounding entries; the current one in the stronger tint.",
      "html": "<div class=\"ds-ctx\"><div class=\"ds-ctxl\"><span>14:08:40</span><span>info</span><span>sshd</span><span class=\"m\">Connection from 10.0.0.54</span></div><div class=\"ds-ctxl ds-cur\"><span>14:08:41</span><span>err</span><span>sshd</span><span class=\"m\">authentication failure; rhost=10.0.0.54</span></div><div class=\"ds-ctxl\"><span>14:08:43</span><span>info</span><span>sshd</span><span class=\"m\">Disconnected from 10.0.0.54</span></div></div>",
      "css": ".ds-ctx{padding:8px 16px 12px 32px;background:var(--tint,#eceef8);color:var(--ink,#111)}.ds-ctxl{display:grid;grid-template-columns:auto 4.5em 9em minmax(0,1fr);gap:0 10px;padding:1px 0;font:12px/1.45 ui-monospace,\"SF Mono\",Menlo,Consolas,monospace}.ds-ctxl>span:not(.m){color:var(--muted,#5e5e5e);white-space:nowrap}.ds-cur{background:var(--tint-strong,#d9dcf1);font-weight:700}"
    }
  ],
  "narrative": {
    "northStar": "The Timetable",
    "overview": "LogPit sets the log stream the way Swiss railway timetable books set departures. The hour is stated once, on a band; every line under it leads with its minutes and seconds in bold tabular figures while the hour recedes in grey; disruptions read in red. Read top to bottom, the stream has the calm, regular cadence of a printed timetable, and an incident shows up the way a cancelled train does: as a red line in an otherwise black column.\n\nThe world has two faces. In light, it is timetable paper: a white ground, near-black ink, hairline rules and a platform-navy band across the top. In dark, it is the station departure board: a deep navy ground, white type and board yellow as the accent. Both are flat, printed surfaces. Nothing floats, nothing glows, nothing eases in; state changes snap like a split-flap board turning over.\n\nThe system is dense but not cramped, and built for long reading during an incident. It rejects the category default (a dark observability console with a grey histogram over undifferentiated rows), the SaaS dashboard (cards, giant KPIs, gradients) and the hacker costume (green on black, CRT, neon). Because the page ships inside the binary under a `default-src 'none'` policy, everything is system type, inline CSS and inline SVG; lightness is part of the look.",
    "keyCharacteristics": [
      "The pinned hour band: the hour stated once in large bold figures, the band sticking under the header while its hour scrolls past.",
      "Bold tabular minutes:seconds leading each line, the hour prefix in grey.",
      "Helvetica-family system stack for everything, monospace reserved for message text.",
      "Colour only for meaning: red for errors and the one primary action, amber for warnings, navy for notices and structure, purple for first-ever patterns, yellow as the board accent at night.",
      "Flat surfaces, hairline rules, radii of 2px at most, no shadows, no easing."
    ],
    "rules": [
      {
        "name": "The Meaning Rule",
        "body": "Colour says something or it is ink. Red is an error or the primary action, amber a warning, navy a notice or structure, purple a first sighting, green a recovery. A coloured element with no such meaning is a defect.",
        "section": "colors"
      },
      {
        "name": "The One Red Button Rule",
        "body": "Exactly one filled red control per screen: Search. Every other button is outlined in field grey on the ground.",
        "section": "colors"
      },
      {
        "name": "The Two Boards Rule",
        "body": "The light theme accent is navy; the dark theme accent is yellow. Never carry yellow into light, never carry navy accents into dark (the dark board is already navy).",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "All figures are tabular (`font-variant-numeric: tabular-nums` on the body). Times, counts and hours must line up in columns like a printed timetable.",
        "section": "typography"
      },
      {
        "name": "The Receding Hour Rule",
        "body": "On a line, the hour is grey and regular, minutes:seconds black and bold. On an error line the whole timestamp turns red, hour included.",
        "section": "typography"
      },
      {
        "name": "The Printed Sheet Rule",
        "body": "Every surface lies on the same sheet of paper (or the same board). If something needs to stand out, give it a rule, a tint or a band, never a shadow or a blur.",
        "section": "elevation"
      },
      {
        "name": "The Hard Step Rule",
        "body": "State changes are immediate: hover fills, open sections, chevrons, selections. No transitions, no animations, no easing.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** state the hour once, on a sticky hour band, and lead every line with bold tabular minutes:seconds with the hour prefix in grey.",
      "**Do** keep every figure tabular so times and counts align in columns.",
      "**Do** reserve red for errors and the single primary action; amber for warnings; navy for notices and structure; purple for first-seen patterns; green for recoveries.",
      "**Do** use board yellow as the only accent in dark, and platform navy as the accent in light.",
      "**Do** separate things with 1px rules (hairline between rows, ink under bands and the chart) and tints, not with boxes.",
      "**Do** keep corners at 2px or square, and keep everything system type, inline CSS and inline SVG.",
      "**Do** keep monospace for message text (messages, patterns, context lines)."
    ],
    "donts": [
      "**Don't** add shadows, blurs, gradients or glows; the world is a printed sheet or a departure board.",
      "**Don't** add transitions or easing; state changes are hard steps.",
      "**Don't** introduce cards, KPI tiles or dashboard chrome.",
      "**Don't** use green-on-black terminal styling, CRT effects or neon.",
      "**Don't** use colour decoratively or to \"brighten\" a section; if it does not mean something it is ink, grey or rule.",
      "**Don't** add a second filled red button, or radii above 2px.",
      "**Don't** load web fonts, icon fonts or any external resource; the CSP forbids it and lightness is the point."
    ]
  }
}
